# Copy to .env and fill in real values. .env is git-ignored.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/change_me_locally

# --- JWT Auth ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=

# --- OpenAI ---
OPENAI_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
